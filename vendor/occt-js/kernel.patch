+    int exactModelId,
+    int exactShapeHandle,
+    TopAbs_ShapeEnum kind,
+    int elementId,
+    TopoDS_Shape& shape)
+{
+    auto& state = State();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    TopoDS_Shape geometry;
+    OcctLifecycleResult status = FindGeometryShape(state, exactModelId, exactShapeHandle, geometry);
+    if (!status.ok) return status;
+
+    const int slot = kind == TopAbs_FACE ? 0 : kind == TopAbs_EDGE ? 1 : 2;
+    const std::string name = slot == 0 ? "face" : slot == 1 ? "edge" : "vertex";
+    auto& topology = state.topology[exactModelId][exactShapeHandle];
+    auto& shapes = topology.shapes[slot];
+    if (!topology.ready[slot]) {
+        TopExp::MapShapes(geometry, kind, shapes);
+        topology.ready[slot] = true;
+    }
