+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFile } from 'node:fs/promises';
+import { loadOcctFactory } from './load_occt_factory.mjs';
+
+const factory = loadOcctFactory();
+
+test('STEP import reports native phases and independent elapsed timings', async () => {
+  const phases = [];
+  const module = await factory({ onProgress: (phase) => phases.push(phase) });
+  const bytes = new Uint8Array(await readFile(new URL('./assembly.step', import.meta.url)));
+  const result = module.OpenExactStepModel(bytes, {});
+  assert.equal(result.success, true);
+  assert.deepEqual(phases, ['read', 'transfer', 'mesh', 'extract', 'output']);
+  for (const phase of ['readMs', 'transferMs', 'meshMs', 'extractMs', 'outputMs', 'totalMs']) {
+    assert.ok(Number.isFinite(result.timings[phase]) && result.timings[phase] >= 0, phase);
+  }
+  const accounted = Object.entries(result.timings).reduce((sum, [key, value]) => sum + (key === 'totalMs' ? 0 : value), 0);
+  assert.ok(result.timings.totalMs >= accounted);
+  assert.equal(module.ReleaseExactModel(result.exactModelId).ok, true);
+});
+
+test('mesh edge ownership agrees with each face boundary, including seam edges', async () => {
+  const module = await factory();
+  const bytes = new Uint8Array(await readFile(new URL('./ANC101_colored.stp', import.meta.url)));
+  const result = module.OpenExactStepModel(bytes, {});
+  assert.equal(result.success, true);
+  for (const geometry of result.geometries) {
+    for (const face of geometry.faces) {
+      assert.equal(new Set(face.edgeIndices).size, face.edgeIndices.length);
+      for (const index of face.edgeIndices) assert.ok(geometry.edges[index].ownerFaceIds.includes(face.id));
+    }
+    for (const [index, edge] of geometry.edges.entries()) {
+      assert.equal(new Set(edge.ownerFaceIds).size, edge.ownerFaceIds.length);
+      assert.equal(edge.isFreeEdge, edge.ownerFaceIds.length === 0);
+      for (const owner of edge.ownerFaceIds) assert.ok(geometry.faces.find((face) => face.id === owner).edgeIndices.includes(index));
+    }
+  }
+  assert.equal(module.ReleaseExactModel(result.exactModelId).ok, true);
+});
